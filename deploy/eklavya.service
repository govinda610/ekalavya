# systemd unit for the Ekalavya multi-user web app (matches docs/DEPLOY_RUNBOOK.md, as-built).
# Install: sudo cp deploy/eklavya.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now eklavya
#
# ONE process = ONE worker on purpose: the login throttle is in-memory/per-process,
# so we never run multiple uvicorn workers (the #52 "single worker" item).

[Unit]
Description=Ekalavya AI coding tutor (multi-user web app)
After=network.target

[Service]
Type=simple
User=eklavya
WorkingDirectory=/opt/eklavya/app
# THE authentication switch: without this the app serves UNAUTHENTICATED. The flag is
# EKLAVYA_DEPLOYED (NOT the retired EKLAVYA_MULTIUSER, which config.py ignores) — reusing a
# unit that sets the wrong var would run the multi-user app with auth OFF.
Environment=EKLAVYA_DEPLOYED=1
Environment=EKLAVYA_DATA_ROOT=/var/lib/eklavya
# Behind nginx (which sets X-Forwarded-For): key the login throttle on the real client IP,
# not nginx's. Only safe because nginx is the sole ingress — never expose the app port
# directly with this on, or a client could spoof the header.
Environment=EKLAVYA_TRUST_PROXY=1
# secrets (EKLAVYA_SECRET_KEY, provider keys, TAVILY/SERPER) live here, chmod 600, NOT in git
EnvironmentFile=/etc/eklavya.env
ExecStart=/opt/eklavya/.local/bin/uv run eklavya serve --host 127.0.0.1 --port 4646 --no-open
Restart=always
RestartSec=3
# harden the service account a little
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eklavya
PrivateTmp=true

[Install]
WantedBy=multi-user.target
