# Ekalavya configuration. Copy to `.env` and fill in what you need.
# `.env` is gitignored — NEVER commit real keys.
#
# The only thing required to get started is ONE provider key (below). Everything
# else has a sane default; the server flags matter only for a multi-user deploy.

# ─────────────────────────────────────────────────────────────────────────────
# PROVIDERS  (set at least one — the tutor teaches with whichever key is present)
# ─────────────────────────────────────────────────────────────────────────────
# All four expose Anthropic-compatible endpoints, so one client talks to any of
# them — just a different base URL + token. Set several to unlock automatic
# failover + optional load-balancing (see EKLAVYA_BALANCE).

# GLM — z.ai coding plan (default provider). Default model: glm-5.2
EKLAVYA_GLM_API_KEY=

# MiniMax — token plan. Default model: MiniMax-M3
EKLAVYA_MINIMAX_API_KEY=

# Qwen — Alibaba Model Studio. Default model: qwen3.8-max-preview
EKLAVYA_QWEN_API_KEY=

# Kimi — Moonshot coding plan. Default model: k3
EKLAVYA_KIMI_API_KEY=

# Pick which provider teaches by default (glm | minimax | qwen | kimi).
# EKLAVYA_PROVIDER=glm

# When multiple keys are set, a session automatically fails over to the next
# configured provider if one is down/rate-limited — no config needed. Set this to
# ALSO spread NEW sessions round-robin across providers (entry load-balancing).
# EKLAVYA_BALANCE=1

# ─────────────────────────────────────────────────────────────────────────────
# SEARCH  (optional — fresh, company-specific interview questions)
# ─────────────────────────────────────────────────────────────────────────────
# Either provider enables web search for the mock/take-home question refresh.
# TAVILY_API_KEY=
# SERPER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# QUALITY  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# The self-check hallucination judge is ON by default. Set to 0 to turn it off.
# EKLAVYA_VERIFY=0

# ─────────────────────────────────────────────────────────────────────────────
# SERVER  (only for the multi-user / hosted `eklavya serve` deployment)
# ─────────────────────────────────────────────────────────────────────────────
# Turn on the hosted posture: full email+password auth, tenant-confined file
# reads, optional signup approval. Off = frictionless local single-user.
# EKLAVYA_DEPLOYED=1

# REQUIRED when EKLAVYA_DEPLOYED=1 — the secret that signs session cookies. The
# app refuses to start deployed without it. Generate one, e.g.:  openssl rand -hex 32
# EKLAVYA_SECRET_KEY=

# New self-service signups land as PENDING until the owner runs `eklavya approve
# <email>` — so opening registration can't be abused. Off by default.
# EKLAVYA_SIGNUP_APPROVAL=1

# Trust the reverse proxy's X-Forwarded-For for login throttling. Set this ONLY
# when the app sits behind a trusted proxy (e.g. Caddy/nginx) that is the sole
# ingress — otherwise a client could spoof the header. Off by default.
# EKLAVYA_TRUST_PROXY=1

# Local HTTP dev only: send session cookies without the Secure flag so login
# works over plain http. NEVER set this in production (HTTPS).
# EKLAVYA_INSECURE_COOKIES=1

# ─────────────────────────────────────────────────────────────────────────────
# DATA ROOT  (optional — where all state lives)
# ─────────────────────────────────────────────────────────────────────────────
# Parent of users/ and the shared users.db. Defaults to ~/.eklavya-data.
# EKLAVYA_DATA_ROOT=/var/lib/eklavya/data
