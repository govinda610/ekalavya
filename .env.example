# Ekalavya — provider credentials. Copy to `.env` and fill in. NEVER commit `.env`.
# Both GLM and MiniMax expose Anthropic-compatible endpoints, so the app talks
# to them with one client, just different base URLs + tokens.

# GLM (z.ai coding plan) — default model: glm-5.2
EKLAVYA_GLM_API_KEY=

# MiniMax (token plan) — default model: MiniMax-M3
EKLAVYA_MINIMAX_API_KEY=

# Qwen (Alibaba Model Studio token/coding plan) — default model: qwen3.8-max-preview
# Anthropic-compatible endpoint, same one client as GLM/MiniMax.
EKLAVYA_QWEN_API_KEY=

# Kimi (Moonshot coding plan) — default model: k3
EKLAVYA_KIMI_API_KEY=

# Optional: override the default provider/model the tutor teaches with.
# EKLAVYA_PROVIDER=glm
# EKLAVYA_MODEL=glm-5.2

# When multiple keys above are set, a session automatically fails over to the next
# configured provider if one is down/rate-limited — no config needed. Set this to
# also spread NEW sessions round-robin across providers (entry load-balancing).
# EKLAVYA_BALANCE=1

# Optional: web search for fresh, company-specific interview questions.
# TAVILY_API_KEY=

# Optional: turn off the self-check hallucination judge (on by default).
# EKLAVYA_VERIFY=0
